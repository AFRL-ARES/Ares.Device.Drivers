@using SpectralCameraRemastered.UI.Models
@using SpectralCameraRemastered.Models
@using Radzen
@using Radzen.Blazor

@inherits ReactiveUI.Blazor.ReactiveComponentBase<SpectralCameraUnitControlViewModel>

<RadzenCard class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="m-0">Calibration Editor</h5>
        <RadzenButton Icon="add" Text="Add Peak" Click="@AddPeak" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" />
    </div>

    <RadzenDataGrid Data="@ViewModel!.CameraState.CalibrationPeaks" TItem="CalibrationPeak" AllowFiltering="false" AllowSorting="false">
        <Columns>
            <RadzenDataGridColumn TItem="CalibrationPeak" Property="Name" Title="Name">
                <EditTemplate Context="peak">
                    <RadzenTextBox @bind-Value="peak.Name" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="CalibrationPeak" Property="PixelNumber" Title="Pixel #">
                <EditTemplate Context="peak">
                    <RadzenNumeric TValue="double" @bind-Value="peak.PixelNumber" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="CalibrationPeak" Property="WaveNumber" Title="Wave #">
                <EditTemplate Context="peak">
                    <RadzenNumeric TValue="double" @bind-Value="peak.WaveNumber" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="CalibrationPeak" Title="Action" Width="100px" TextAlign="TextAlign.Center">
                <Template Context="peak">
                    <RadzenButton Icon="delete" Click="@(() => RemovePeak(peak))" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <div class="mt-3 d-flex justify-content-end gap-2">
        <RadzenButton Text="Recalculate" Click="@ApplyCalibration" ButtonStyle="ButtonStyle.Primary" />
    </div>
</RadzenCard>

@code {
    private void AddPeak()
    {
        var newPeak = new CalibrationPeak("New Peak", 0, 0);
        ViewModel!.CameraState.CalibrationPeaks.Add(newPeak);
        StateHasChanged();
    }

    private void RemovePeak(CalibrationPeak peak)
    {
        ViewModel!.CameraState.CalibrationPeaks.Remove(peak);
        StateHasChanged();
    }

    private void ApplyCalibration()
    {
        ViewModel!.Device.UpdateCalibration(ViewModel.CameraState.CalibrationPeaks);
        // Recalculating state manually here for immediate UI feedback if needed, 
        // though the polling loop will catch it in the next cycle.
    }
}
