@using SpectralCameraRemastered.UI.Models
@using Radzen
@using Radzen.Blazor

@inherits ReactiveUI.Blazor.ReactiveComponentBase<SpectralCameraUnitControlViewModel>

<div class="spectral-camera-container p-3">
    <div class="header d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0">@ViewModel!.Device.Name</h4>
        <RadzenBadge BadgeStyle="@(ViewModel.CameraState.Status == "Idle" ? BadgeStyle.Info : BadgeStyle.Warning)" 
                     Text="@ViewModel.CameraState.Status" />
    </div>

    <div class="row">
        <div class="col-md-4">
            <RadzenCard>
                <h5 class="mb-3">Temperature Control</h5>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between">
                        <span>Current:</span>
                        <span class="fw-bold">@ViewModel.CameraState.Temperature.ToString("F1") °C</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Setpoint:</span>
                        <RadzenNumeric TValue="double" @bind-Value="@ViewModel.TargetTempSetpoint" Style="width: 80px;" />
                    </div>
                    <RadzenButton Text="Set Temp" Click="@(() => ViewModel.Device.UpdateSettings(Ares.Datamodel.Factories.AresStateBuilder.Create().Add("TempSetpoint", ViewModel.TargetTempSetpoint).Build()))" 
                                  ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
                </div>
            </RadzenCard>

            <RadzenCard class="mt-3">
                <h5 class="mb-3">Acquisition Settings</h5>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Exposure (s):</span>
                        <RadzenNumeric TValue="double" @bind-Value="@ViewModel.TargetExposureTime" Style="width: 80px;" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Averaging:</span>
                        <RadzenNumeric TValue="int" @bind-Value="@ViewModel.Iterations" Style="width: 80px;" Min="1" />
                    </div>
                </div>
            </RadzenCard>

            <div class="mt-3 d-grid gap-2">
                <RadzenButton Text="@(ViewModel.CameraState.IsScanning ? "Stop Scan" : "Start Continuous")" 
                              Click="@(() => ViewModel.ContinuousScanCommand.Execute().Subscribe())"
                              ButtonStyle="@(ViewModel.CameraState.IsScanning ? ButtonStyle.Danger : ButtonStyle.Primary)" />
                
                <RadzenButton Text="Single Scan" 
                              Click="@(() => ViewModel.SingleScanCommand.Execute().Subscribe())"
                              Disabled="@ViewModel.CameraState.IsScanning"
                              ButtonStyle="ButtonStyle.Secondary" />

                <RadzenButton Text="Abort" Click="@(() => ViewModel.AbortAcqCommand.Execute().Subscribe())"
                              ButtonStyle="ButtonStyle.Light" />
            </div>
        </div>

        <div class="col-md-8">
            <RamanGraphArea Data="@ViewModel.CameraState.CalibratedData" 
                            Peaks="@ViewModel.CameraState.CalibrationPeaks" />
            
            <RadzenAccordion class="mt-3">
                <Items>
                    <RadzenAccordionItem Text="Calibration Peaks" Icon="tune">
                        <CalibrationEditor ViewModel="@ViewModel" />
                    </RadzenAccordionItem>
                </Items>
            </RadzenAccordion>
        </div>
    </div>
</div>

<style>
    .spectral-camera-container {
        background-color: var(--rz-background-color);
        border-radius: 8px;
    }
</style>
