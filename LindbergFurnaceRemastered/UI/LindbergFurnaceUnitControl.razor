@using UnitsNet;
@using UnitsNet.Units;
@inherits ReactiveUI.Blazor.ReactiveComponentBase<LindbergFurnaceUnitControlViewModel>

@inject DialogService DialogService
@inject TooltipService TooltipService

<div class="d-flex flex-column align-items-stretch gap-2">
  <!-- Header & Device Name -->
  <div class="d-flex">
    <div class="h5 flex-fill m-0">@ViewModel!.DeviceName</div>
  </div>

  <!-- Temperature Unit Dropdown -->
  <div>
    <label class="form-label form-label-sm text-muted mb-1">Unit</label>
    <select class="form-select text-center" @bind="TemperatureUnit">
      @foreach(var tempUnit in TemperatureUnits)
      {
        <option>@tempUnit</option>
      }
    </select>
  </div>

  <!-- Dual Readout Boxes: Current Temperature & Current Setpoint -->
  <div class="row g-2">
    <div class="col-6">
      <label class="form-label form-label-sm text-muted mb-1">Current Temp</label>
      <input class="form-control text-center fw-bold" disabled readonly value="@CurrentTemperatureDisplay" />
    </div>
    <div class="col-6">
      <label class="form-label form-label-sm text-muted mb-1">Setpoint</label>
      <input class="form-control text-center fw-bold" disabled readonly value="@CurrentSetpointDisplay" />
    </div>
  </div>

  <!-- New Target Temperature Input and Submit -->
  <div class="mt-1">
    <label class="form-label form-label-sm text-muted mb-1">New Target Setpoint</label>
    <div class="input-group">
      <input type="number"
             class="form-control text-center"
             placeholder="@TargetTemperaturePlaceholder"
             @bind="TargetTemperatureInput"
             @bind:event="oninput" />
      <button class="btn btn-primary" type="button" @onclick="SubmitTemperature">Set</button>
    </div>
  </div>
</div>

@code {
  private int? TargetTemperatureInput { get; set; }

  private string CurrentTemperatureDisplay
  {
    get
    {
      if(ViewModel?.CurrentTemperatureValue is null)
        return "Unknown";

      var temp = Temperature.From(ViewModel.CurrentTemperatureValue.Value, ViewModel.TemperatureUnit);
      return $"{temp.Value:#0.##} {UnitsNet.UnitAbbreviationsCache.Default.GetDefaultAbbreviation(ViewModel.TemperatureUnit)}";
    }
  }

  private string CurrentSetpointDisplay
  {
    get
    {
      if(ViewModel?.TargetTemperatureValue is null)
        return "Not Set";

      var temp = Temperature.From(ViewModel.TargetTemperatureValue.Value, ViewModel.TemperatureUnit);
      return $"{temp.Value:#0.##} {UnitsNet.UnitAbbreviationsCache.Default.GetDefaultAbbreviation(ViewModel.TemperatureUnit)}";
    }
  }

  private string TargetTemperaturePlaceholder =>
    $"Enter ({UnitsNet.UnitAbbreviationsCache.Default.GetDefaultAbbreviation(ViewModel!.TemperatureUnit)})";

  private async Task SubmitTemperature()
  {
    if(TargetTemperatureInput is null || ViewModel is null)
      return;

    // Push local staging value to ViewModel
    ViewModel.TargetTemperatureValue = TargetTemperatureInput;

    // Execute target temperature update command
    await ViewModel.SetTargetTemperature();

    // Clear local staging property so the input box resets
    TargetTemperatureInput = null;
  }

  private string[] TemperatureUnits =>
    Temperature.Units.Select(unit => UnitsNetSetup.Default.UnitAbbreviations.GetDefaultAbbreviation(unit)).ToArray();

  private string TemperatureUnit
  {
    get => UnitsNetSetup.Default.UnitAbbreviations.GetDefaultAbbreviation(ViewModel!.TemperatureUnit);
    set
    {
      if(UnitsNetSetup.Default.UnitParser.TryParse<TemperatureUnit>(value, out var tempUnit))
      {
        ViewModel!.TemperatureUnit = tempUnit;
      }
    }
  }
}