<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>true</GenerateDependencyFile>

    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ares.Toolkit.Device" Version="1.6.0" />
    <PackageReference Include="Ares.Toolkit.Serial" Version="1.1.0" />
    <PackageReference Include="ReactiveUI.Blazor" Version="23.2.28" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="3.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PackageAresDriver" AfterTargets="Build">
    <PropertyGroup>
      <StagingFolder>$(ProjectDir)obj\AresStaging\</StagingFolder>
      <PackageName>$(ProjectDir)..\plugins\$(AssemblyName).ares</PackageName>
    </PropertyGroup>

    <ItemGroup>
      <ScopedCssBundle Include="$(IntermediateOutputPath)scopedcss\bundle\$(ProjectName).styles.css" Condition="Exists('$(IntermediateOutputPath)scopedcss\bundle\$(ProjectName).styles.css')" />
    </ItemGroup>

    <Copy SourceFiles="@(ScopedCssBundle)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(ScopedCssBundle)' != ''" />

    <RemoveDir Directories="$(StagingFolder)" />
    <MakeDir Directories="$(StagingFolder)" />
    <MakeDir Directories="$(ProjectDir)..\plugins" />

    <Copy SourceFiles="manifest.yaml" DestinationFolder="$(StagingFolder)" />

    <ItemGroup>
      <AllOutputFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)Ares.Device.dll;$(TargetDir)Ares.Datamodel.dll;$(TargetDir)obj\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(AllOutputFiles)" DestinationFiles="@(AllOutputFiles->'$(StagingFolder)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <ZipDirectory SourceDirectory="$(StagingFolder)" DestinationFile="$(PackageName)" Overwrite="true" />
    <RemoveDir Directories="$(StagingFolder)" />
  </Target>

</Project>

